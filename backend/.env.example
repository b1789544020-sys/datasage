# =====================================================================
# DataSage 后端环境变量示例
# 用法：复制本文件为 .env 后按需修改（cp .env.example .env）
# =====================================================================

# ---- 应用 ----------------------------------------------------------
# 应用名称（会显示在 OpenAPI 文档标题等处）
APP_NAME=DataSage
# 调试模式：true 时开启 SQL 语句回显、详细错误信息等
DEBUG=true

# ---- LLM 大模型 -----------------------------------------------------
# LLM 服务提供商，三选一：
#   mock      不调用任何真实 API，本地桩实现完整分析链路，零 Key 离线可跑
#   openai    OpenAI 兼容接口（DeepSeek、Moonshot、通义千问等均兼容此协议）
#   anthropic Anthropic Claude 官方接口（经 OpenAI 兼容网关接入）
DATASAGE_LLM_PROVIDER=mock
# LLM API Key（DeepSeek 控制台申请：https://platform.deepseek.com/）
# mock 模式留空即可；切到 openai 时必填
LLM_API_KEY=
# LLM API 基础地址，必须是 OpenAI 兼容端点（默认 DeepSeek 官方地址）
# DeepSeek : https://api.deepseek.com/v1
# Moonshot : https://api.moonshot.cn/v1
# 通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称（DeepSeek：deepseek-chat / deepseek-reasoner）
LLM_MODEL=deepseek-chat

# ---- 反幻觉演示模式 -------------------------------------------------
# 仅在 DATASAGE_LLM_PROVIDER=mock 时生效。
# 设为 true 后，"最终答案初稿"会刻意写入数据中不存在的编造数字（候选数字
# 先经真实回溯器自检，保证必被抓出），随后由数字回溯拦截并自动重生成，
# 浏览器里能直接看到"红色幻觉初稿 -> 自动重写 -> 绿色全通过"。
# 录屏 / 面试演示时设 true，日常使用与测试保持 false。
DATASAGE_DEMO_HALLUCINATION=false

# ---- 数据库 ---------------------------------------------------------
# 数据库连接地址。默认本地 SQLite 文件；
# 若写成 sqlite:/// 前缀，启动时会自动补齐为 sqlite+aiosqlite:/// 异步驱动
DATABASE_URL=sqlite:///./datasage.db
